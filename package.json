{
  "name": "pl-section-sync",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Sync PrairieLearn section labels from a Canvas gradebook.",
  "license": "MIT",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "package": "npm run build && node scripts/package.mjs",
    "verify": "npm run check && npm test && npm run test:ui && node scripts/package.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.2.9",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.2",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}

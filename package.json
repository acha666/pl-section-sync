{
  "name": "pl-section-sync",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Sync PrairieLearn section labels from a Canvas gradebook.",
  "license": "MIT",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build": "vite build",
    "test": "npm run build && vitest run",
    "package": "npm run build && node scripts/package.mjs",
    "verify": "npm run check && npm test && npm run test:ui && node scripts/package.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.2.9",
    "@types/papaparse": "^5.5.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.2",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "preact": "^11.0.1",
    "zod": "^4.6.7"
  }
}
